{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playground game catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["games"],
  "properties": {
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "git", "ref", "dockerfile", "containerPort"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$",
            "description": "DNS label used in the container name and in <id>.<gamesDomain>. Capitals are folded to lowercase."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "git": {
            "type": "string",
            "pattern": "^(https://|git@|ssh://)\\S+$",
            "description": "Repository URL. Use https, git@, or ssh. Do not embed credentials."
          },
          "ref": {
            "type": "string",
            "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
            "description": "Branch or tag to clone."
          },
          "dockerfile": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$",
            "description": "Dockerfile path relative to the repository root."
          },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Port the game listens on inside the container."
          },
          "healthPath": {
            "type": "string",
            "pattern": "^/",
            "description": "HTTP path polled after start. Defaults to /."
          },
          "hostPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Localhost port published when PUBLISH_HOST is set."
          }
        }
      }
    }
  }
}
